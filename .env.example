# Copy this file to .env (same folder) and fill in your own keys.
# .env holds secrets: never send it to anyone and never publish it.

# Stripe: https://dashboard.stripe.com/test/apikeys
# Start with the TEST key (sk_test_...). Switch to the live key (sk_live_...) only when the shop is online with HTTPS.
STRIPE_SECRET_KEY=

# From "stripe listen" on your computer (whsec_...), or from Dashboard > Developers > Webhooks once the site is online
STRIPE_WEBHOOK_SECRET=

# The address customers use to open the shop (Stripe sends them back here after paying)
PUBLIC_URL=http://localhost:5173

# Newsletter ("Bëhu pjesë e fisit"), optional. Without these the addresses are only kept in the dashboard.
# Brevo (free plan): SMTP & API > API keys > Generate a new API key (xkeysib-...)
BREVO_API_KEY=
# Brevo: Contacts > Lists, the ID number of your list
BREVO_LIST_ID=
# Brevo: Campaigns > Templates, the ID number of the double opt-in confirmation template
BREVO_DOI_TEMPLATE_ID=
# Optional: the address the emails come from. It must be a verified sender in Brevo (Senders > Add a sender). Empty: the first one.
BREVO_SENDER_EMAIL=
